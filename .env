# ---- Required ----
# Base RPC endpoint. Public one works for testing; a free Alchemy/QuickNode key is faster.
RPC_URL=

# Burner wallet private key (with or without 0x). ONLY use a fresh wallet holding gas money.
PRIVATE_KEY=

# ---- Behavior ----
# true = never sends transactions, only logs what it WOULD do. Start here!
DRY_RUN=true

# Where claimer fees are credited. Defaults to the wallet address.
FEE_RECIPIENT=

# Loop interval in minutes when using `node bot.js loop`
LOOP_MINUTES=10

# Only claim when expected fees exceed gas cost by this margin (%)
MIN_MARGIN_PCT=25

# Max prizes per claim transaction (bigger batch = more fee, more gas)
MAX_CLAIMS_PER_TX=50

# Prize tiers to scan, comma separated (0 = grand prize ... 5,6 = canary tiers).
# Canary tiers have 4^5=1024 and 4^6=4096 prize indices each and dominate scan cost.
TIERS=0,1,2,3,4,5,6

# Max accounts to scan per vault (sorted by balance, biggest first).
# Full scan of the big USDC vault = ~1100 accounts x 5461 prize indices.
MAX_ACCOUNTS=250

# Only scan vaults with at least this much TVL (USD, recognized stablecoin/ETH assets)
MIN_VAULT_TVL_USD=1000

# Rough ETH price used for TVL filtering and profit logging
ETH_PRICE_USD=3500

# Sweep accumulated fees to your wallet when balance exceeds this much WETH
SWEEP_MIN_WETH=0.0001
